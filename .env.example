# 复制为 .env（权限 600）。所有密钥只存在于运行流水线的机器上，永远不要提交。

# ---- OpenAI 兼容接口：图像生成/编辑 + 视觉规划 ----
LLM_API_KEY=替换成你的密钥
# 留空则用 SDK 默认地址（https://api.openai.com/v1）；任何 OpenAI 兼容网关都可以。
LLM_API_BASE_URL=
LLM_API_TIMEOUT_SECONDS=600
LLM_API_MAX_RETRIES=1
# 图像模型：需要支持 images.generate（可选透明背景）与带遮罩的 images.edit。
IMAGE_MODEL=替换成图像模型名
# 规划模型：读图并返回 JSON 的视觉模型，用于拆层规划、关卡审查与 QA 报告。
PLANNER_MODEL=替换成视觉模型名
PLANNER_REASONING_EFFORT=low
PLANNER_STREAM_RETRIES=1
# Optional local companion chat; choose a conversational model from the same API.
# CHAT_MODEL=your-chat-model
# Optional microphone input and Chinese cloud speech for adapters/local_chat.
# Keep these credentials in a private file passed via --speech-env-file.
# TENCENT_ASR_SECRET_ID=replace-me
# TENCENT_ASR_SECRET_KEY=replace-me
# TENCENT_ASR_REGION=ap-beijing
# LOCAL_TTS_PROVIDER=tencent
# LOCAL_TTS_VOICE=603006
# 提示词生成先请求透明背景；供应商不支持时自动改为普通生成。
IMAGE_BACKGROUND=transparent

# ---- 监督层 ----
# act（默认）：检查实际导出的模型，最多自动修复三轮；局部图像编辑会产生模型调用费用。
# shadow：只检查不自动修复；off：不调监督模型。严重问题或缺少视觉结论时均保留为 needs_review。
LIVE2D_SUPERVISOR_MODE=act
# 留空则与 PLANNER_MODEL 相同。
SUPERVISOR_MODEL=
SUPERVISOR_REASONING_EFFORT=low
SUPERVISOR_TIMEOUT_SECONDS=90

# ---- 远程 GPU：See-through 拆层（~/.ssh/config 里的主机别名，需免密登录）----
REMOTE_SSH_HOST=替换成SSH主机别名
REMOTE_ROOT=/root/live2d-ai
REMOTE_PYTHON=python3
REMOTE_SEE_THROUGH=/root/live2d-ai/third_party/see-through
REMOTE_MODEL_ROOT=/root/live2d-ai/models

# ---- 本机绑定与校验工具链 ----
LIVE2D_JAVA_HOME=/path/to/jdk-21/Contents/Home
LIVE2D_KIT_DIR=/path/to/live2d-agent-kit
LIVE2D_ENGINE_DIR=/path/to/psd2live
# 含 Live2DCubismCore.jar 与对应 JNI 动态库的目录，来自你自己安装的 Cubism Editor / SDK；不入库、不随本项目分发。
CUBISM_CORE_DIR=/Applications/Live2D Cubism 5.3/res
# 可选：open-cubism 子命令使用
CUBISM_EDITOR=/Applications/Live2D Cubism 5.3/Live2D Cubism Editor 5.3.app

# ---- 队列适配器 adapters/anyi/worker.py（只有当流水线作为服务接在任务队列后面时才需要）----
# ANYI_API_URL=https://your-api.example.com
# ANYI_WORKER_TOKEN=至少32位的随机密钥
