APEXIN_BASE_URL=https://api.apexin.ai/v1
APEXIN_API_KEY=替换成你的API密钥
ASTRA_MODEL=gpt-6-astra
ASTRA_REASONING_EFFORT=low
IMAGE_MODEL=gpt-image-2.5-sunburst
APEXIN_TIMEOUT_SECONDS=600
APEXIN_MAX_RETRIES=1
ASTRA_STREAM_RETRIES=1
CUBISM_EDITOR=/Applications/Live2D Cubism 5.3/Live2D Cubism Editor 5.3.app
REMOTE_SSH_HOST=seetacloud
REMOTE_ROOT=/root/live2d-ai
REMOTE_PYTHON=/root/autodl-tmp/live2d-ai/venv/bin/python
REMOTE_SEE_THROUGH=/root/live2d-ai/third_party/see-through
HF_ENDPOINT=https://hf-mirror.com

REMOTE_MODEL_ROOT=/root/autodl-tmp/live2d-ai/models
